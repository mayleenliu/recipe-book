formulas:
  Progress: |-
    if(current_page == 0, "Not started",
    if(current_page >= pages, "Finished",
    ((current_page / number(pages) * 100)).floor() + "%"))
views:
  - type: cards
    name: Library
    filters:
      and:
        - file.inFolder("Books")
        - '!file.inFolder("Books/Images")'
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - formula.Progress
    cardSize: 150
    imageAspectRatio: 1.5
    image: note.cover
  - type: table
    name: Table
    filters:
      and:
        - file.inFolder("Books")
        - '!file.inFolder("Books/Images")'
    order:
      - title
      - author
      - rating
      - tags
      - comments
    sort:
      - property: rating
        direction: DESC
