views:
  - type: cards
    name: Meals
    filters:
      and:
        - file.inFolder("food/Meal")
        - '!file.name.contains("index")'
        - '!file.name.contains("404")'
        - '!file.inFolder("Food/images")'
    order:
      - file.name
    image: note.cover
    imageAspectRatio: 1
    cardSize: 160
  - type: cards
    name: Desserts
    filters:
      and:
        - file.inFolder("food/Dessert")
        - '!file.name.contains("index")'
