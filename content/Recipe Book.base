views:
  - type: cards
    name: Meals
    filters:
      and:
        - file.inFolder("Food/Meal")
        - '!file.name.contains("index")'
        - '!file.name.contains("404")'
        - '!file.inFolder("Food/Images")'
    order:
      - file.name
    image: note.cover
    imageAspectRatio: 1
    cardSize: 160
  - type: cards
    name: Desserts
    filters:
      and:
        - file.inFolder("Food/Dessert")
        - '!file.name.contains("index")'
        - '!file.name.contains("404")'
